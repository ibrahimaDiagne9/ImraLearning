# --- DJANGO SETTINGS ---
DEBUG=False
SECRET_KEY=your-super-secret-production-key-here
ALLOWED_HOSTS=api.yourdomain.com,your-app.vercel.app

# --- DATABASE (Neon Postgres) ---
# Format: postgres://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgres://user:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/dbname?sslmode=require

# --- CORS & CSRF ---
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://your-app.vercel.app

# --- PAYDUNYA (API KEYS) ---
PAYDUNYA_MASTER_KEY=your_production_master_key
PAYDUNYA_PRIVATE_KEY=your_production_private_key
PAYDUNYA_TOKEN=your_production_token

# --- FRONTEND ---
FRONTEND_URL=https://yourdomain.com
